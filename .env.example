# ============================================
# Personal Cloud Gallery — Environment Config
# ============================================
# Copy this file to .env and fill in the values.

# GitHub OAuth App credentials
# Create at: https://github.com/settings/developers
# Homepage URL: http://localhost:3000
# Callback URL: http://localhost:8000/api/auth/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# JWT Secret Key (generate with: openssl rand -hex 32)
SECRET_KEY=your_super_secret_jwt_key_change_me_in_production

# Fernet Encryption Key for GitHub tokens
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Database
DATABASE_URL=sqlite:///./data/gallery.db

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# GitHub OAuth Redirect URI
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Upload limits
MAX_FILE_SIZE=104857600

# Next.js public env
NEXT_PUBLIC_API_URL=http://localhost:8000/api
